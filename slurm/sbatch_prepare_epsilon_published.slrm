#!/bin/bash
#SBATCH --job-name=epsilon-published-splits
#SBATCH -A def-sushant
#SBATCH -c 4
#SBATCH --mem=16G
#SBATCH --gres=gpu:1
#SBATCH --time=2:00:00
#SBATCH --open-mode=append
#SBATCH --output=logs/epsilon_prepare_%j.out
#SBATCH --error=logs/epsilon_prepare_%j.err

set -euo pipefail

cd ~/projects/def-sushant/jikael/mutation-prediction
source .venv/bin/activate

export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"

python -u scripts/check_published_splits_red_green.py

python -u -m mutation_prediction.prepare_targets \
  --device cuda \
  --output data/processed/thermompnn/Megascale-D-epsilon.csv

export MEGASCALE_EPSILON_CSV=data/processed/thermompnn/Megascale-D-epsilon.csv
python -m unittest discover -s tests -p test_published_epsilon_export.py -v
